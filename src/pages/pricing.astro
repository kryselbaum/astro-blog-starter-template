---
import Page from "../layouts/Page.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";

const rows = [
	{ name: "Strategic audit", href: "/rescue", what: "Tech, design and conversion of your website, store or app, with a written report.", price: "€290", time: "3-5 days", note: "Fully deducted if you hire me for the project" },
	{ name: "Lightning-fast landing page", href: "/landing-pages", what: "Custom sales page.", price: "from €1,200", time: "2-3 weeks", note: "Typical: €1,200-2,500" },
	{ name: "Company website", href: "/landing-pages", what: "Multi-page business website.", price: "from €2,400", time: "3-5 weeks", note: "Typical: €2,400-5,000" },
	{ name: "Online store", href: "/online-stores", what: "A light, fast store that you own.", price: "from €3,900", time: "4-8 weeks", note: "Typical: €3,900-9,000" },
	{ name: "From rented to owned", href: "/platform-migration", what: "Moving your store without losing rankings.", price: "fixed quote", time: "by catalogue", note: "After the audit" },
	{ name: "iOS and Android app", href: "/apps", what: "First app from a single codebase.", price: "from €3,000", time: "from 4 weeks", note: "Typical: €3,000-12,000" },
	{ name: "App with server and integrations", href: "/apps", what: "Full product.", price: "custom", time: "from 2 months", note: "From €12,000" },
	{ name: "Project rescue", href: "/rescue", what: "A site or store that doesn't sell or was left half-done.", price: "from €1,200", time: "case by case", note: "Typical: €1,200-4,000" },
	{ name: "AI for your business", href: "/ai", what: "Consulting and implementation: assistant, chat sales, automations.", price: "€75/h", time: "", note: "Implementation on a fixed quote" },
	{ name: "QR menu and table ordering", href: "/restaurants", what: "For restaurants, cider houses and bars.", price: "from €490", time: "", note: "Plus €29/month. Demo available" },
	{ name: "One-off work", href: "/maintenance", what: "Specific fixes and changes.", price: "€60/h", time: "", note: "Packs from 5 hours" },
];

const plans = [
	{ name: "Care", price: "€79", text: "Your site always up to date: daily monitoring, updates, security, backups and written support. Changes are billed separately." },
	{ name: "Growth", price: "€190", text: "Everything in Care plus 2 hours of changes a month, technical SEO and a monthly report with data, not fluff.", featured: true },
	{ name: "Partner", price: "€490", text: "Your external digital team: 6 hours of work a month, top priority and quarterly strategy." },
];

const faq = [
	{ q: "Why don't you publish an exact price?", a: "Because no two stores are the same. I publish the starting point and the typical range. You get the exact price in writing before we start, and it doesn't change along the way." },
	{ q: "Why these prices, if you're senior?", a: "Because I'm starting the studio afresh in Spain: my past clients are in other countries and I don't have reviews here yet. I'd rather earn them with real projects than with ads. That's why I ask for the case study and the review in return." },
	{ q: "How do I pay?", a: "50% at the start and 50% at launch. For projects over €10,000, by milestones: 40/40/20." },
	{ q: "What if I'm not satisfied?", a: "I redo it or refund you. I work for my reputation, not to bill more." },
	{ q: "Are there mandatory monthly costs?", a: "Only the domain and hosting, which cost little for a lightweight site. Maintenance is optional, with no minimum term." },
	{ q: "Do you charge VAT?", a: "Prices are shown without VAT. I invoice as a self-employed professional registered in Spain, and VAT is applied according to where you and your business are based." },
];
---

<Page
	title="Pricing · Víctor Kuminov"
	description="Clear, senior-level pricing: landing page from €1,200, online store from €3,900, app from €3,000, audit €290, maintenance from €79/month. A real guarantee."
>
	<section class="hero hero--page">
		<div class="container">
			<p class="eyebrow">Pricing</p>
			<h1>Clear prices, senior level</h1>
			<p class="lead">
				I'm not the cheapest option out there. I'm the one you won't have to pay twice. You know the
				price and the deadline before we start, and they don't change along the way.
			</p>
		</div>
	</section>

	<section class="section section--tight">
		<div class="container">
			<table class="ptable">
				<thead>
					<tr><th>Service</th><th>Price</th><th>Timeline</th><th>Details</th></tr>
				</thead>
				<tbody>
					{rows.map((r) => (
						<tr>
							<td><a href={r.href}>{r.name}</a><br /><span class="muted small">{r.what}</span></td>
							<td class="p">{r.price}</td>
							<td>{r.time}</td>
							<td class="muted small">{r.note}</td>
						</tr>
					))}
				</tbody>
			</table>
			<p class="muted small" style="margin-top:1rem">All prices + VAT.</p>
			<p class="launch">
				<strong>Launch pricing.</strong> In return I ask for two things: permission to show your
				project as a case study and an honest review when we finish.
			</p>
		</div>
	</section>

	<section class="section section--alt">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">After launch</p>
				<h2>Monthly maintenance</h2>
				<p>No minimum term. If you stay, it's because the work pays off, not because of a contract.</p>
			</div>
			<div class="grid grid--3">
				{plans.map((p) => (
					<div class:list={["card", "plan", { "plan--featured": p.featured }]}>
						{p.featured && <span class="badge">Most popular</span>}
						<h3>{p.name}</h3>
						<p class="price">{p.price}<small>/month</small></p>
						<p>{p.text}</p>
					</div>
				))}
			</div>
			<p class="muted" style="margin-top:1.5rem">
				AI visibility add-on: €100-150/month. <a href="/seo-ai-visibility">What it is</a>
			</p>
		</div>
	</section>

	<section class="section section--dark">
		<div class="container split">
			<p class="eyebrow">Guarantee</p>
			<p class="callout">If you're not satisfied with the result, I redo it or give you your money back. That simple.</p>
		</div>
	</section>

	<section class="section">
		<div class="container split">
			<h2>Questions about price</h2>
			<Faq items={faq} />
		</div>
	</section>

	<CtaBand />
</Page>

<style>
	.launch {
		margin-top: var(--s3);
		padding: var(--s3);
		border-left: 3px solid var(--green);
		background: var(--green-soft);
		max-width: 46rem;
	}
</style>
