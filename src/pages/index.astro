---
import { Image } from "astro:assets";
import Page from "../layouts/Page.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import Arrow from "../components/Arrow.astro";
import { services } from "../data/services";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import victor from "../assets/victor.png";

const mainSlugs = ["landing-pages", "online-stores", "apps", "rescue"];
const main = mainSlugs.map((s) => services.find((x) => x.slug === s)!);
const more = services.filter((s) => !mainSlugs.includes(s.slug));

const faq = [
	{
		q: "Do you only work in Spain?",
		a: "No. The studio is in Asturias, in northern Spain, but I work with clients across Spain, Europe and beyond. The process is 100% remote, with written weekly updates and visible progress from the first week.",
	},
	{
		q: "Why do you cost more than a freelancer?",
		a: "Because there are no juniors learning on your money here. Strategy, design and code are done by two seniors with 20 years of experience, and the result doesn't need redoing next year.",
	},
	{
		q: "How long does it take?",
		a: "A landing page, 2-3 weeks. An online store, 4-8. An app, from 4 weeks for a first version. You get a fixed date before we start, and I keep it.",
	},
	{
		q: "How do I pay?",
		a: "50% at the start and 50% at launch. For projects over €10,000, by milestones: 40/40/20.",
	},
	{
		q: "What if I don't like the result?",
		a: "I redo it or give you your money back. Simple as that.",
	},
	{
		q: "Will I be able to manage it myself?",
		a: "Yes. You get video training and 30 days of support included. And if you'd rather forget about the technical side, maintenance plans start at €490/month.",
	},
	{
		q: "What language do we work in?",
		a: "In English, Spanish or Russian, in writing. Briefs, proposals and updates are written down, so nothing gets lost in a call.",
	},
];

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION} schema={[faqSchema]}>
	<section class="hero home-hero">
		<div class="container hero-grid">
			<div>
				<p class="eyebrow">Design and development studio · Spain and worldwide</p>
				<h1>High-end design and development for businesses that want to sell more.</h1>
				<p class="lead">
					Landing pages that load in under a second, frictionless online stores and apps for iPhone
					and Android. With the experience of having worked for LG, Sisley and Toyota, and the
					direct contact of a two-senior studio.
				</p>
				<div class="btn-row">
					<a class="btn btn--primary" href="/contact">Tell me about your project <Arrow /></a>
					<a class="btn btn--ghost" href="/pricing">See services and pricing</a>
				</div>
			</div>
			<figure class="hero-photo">
				<Image src={victor} alt="Víctor Kuminov" widths={[360, 520, 720]} sizes="(min-width: 900px) 420px, 90vw" loading="eager" fetchpriority="high" class="portrait" />
			</figure>
		</div>
		<div class="container">
			<ul class="proof">
				<li><b>20+ years</b> in digital</li>
				<li><b>100+</b> projects</li>
				<li><b>LG · Sisley · Toyota</b></li>
				<li>Platinum e-commerce partner</li>
				<li>Clients who stay <b>10+ years</b></li>
			</ul>
		</div>
	</section>

	<section class="section section--alt">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Services</p>
				<h2>What I build</h2>
				<p>Four products with a clear starting price. The exact figure is fixed before we start.</p>
			</div>
			<div class="grid grid--4">
				{main.map((s, i) => <ServiceCard service={s} num={`0${i + 1}`} />)}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head">
				<h2>And everything around it</h2>
				<p>Artificial intelligence, restaurants, selling abroad, search visibility and maintenance.</p>
			</div>
			<div class="grid grid--3">
				{more.map((s) => <ServiceCard service={s} />)}
			</div>
			<p style="margin-top:2rem"><a class="link-arrow" href="/platform">Everything every store includes</a></p>
		</div>
	</section>

	<section class="section section--alt">
		<div class="container split">
			<div class="sticky">
				<p class="eyebrow">Why it works</p>
				<h2>Why my projects sell</h2>
			</div>
			<div class="reasons">
				<div>
					<h3>Measurable speed</h3>
					<p>Under one second to load. Google rewards it, your customers notice it and your sales show it. Check for yourself: at the very bottom, this page tells you how long it took.</p>
				</div>
				<div>
					<h3>Design that converts</h3>
					<p>Every screen has a goal. No empty decoration: design built to sell, not to show off.</p>
				</div>
				<div>
					<h3>Seniors only</h3>
					<p>You talk directly to the people who design and build your project. No sales reps, no juniors, no broken telephone.</p>
				</div>
				<div>
					<h3>Your site is yours</h3>
					<p>You pay once and the result belongs to you. No monthly platform rent, no plugins that break, no surprises on the invoice.</p>
				</div>
				<div>
					<h3>A real guarantee</h3>
					<p>If you're not satisfied, I redo it or refund you. I've lived on my reputation for 20 years.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section section--dark">
		<div class="container">
			<p class="eyebrow">Case study</p>
			<h2 class="case-title">From a century-old workshop to sales in 40+ countries</h2>
			<p class="lead">
				A historic craft manufacturer had spent six months with an online store that sold nothing.
				I relaunched it in under a month. More than ten years later they're still with me, and
				their pieces travel from New Zealand to the Americas.
			</p>
			<ul class="metrics">
				<li><b>1 month</b>from a dead store to sales</li>
				<li><b>10+ years</b>still a client</li>
				<li><b>40+</b>countries with active sales</li>
			</ul>
			<div class="btn-row">
				<a class="btn btn--ghost" href="/work">See all work <Arrow /></a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Process</p>
				<h2>How we work</h2>
			</div>
			<ol class="steps">
				<li><h3>Brief and audit</h3><p>I get to know your business and tell you what it really needs, and what it doesn't.</p></li>
				<li><h3>Fixed proposal</h3><p>Fixed price and deadline before we start. They don't change along the way.</p></li>
				<li><h3>Design and build</h3><p>Progress every week. You watch your project grow, not a report.</p></li>
				<li><h3>Launch and growth</h3><p>We measure, improve, and your site starts working for you.</p></li>
			</ol>
		</div>
	</section>

	<section class="section section--alt">
		<div class="container split">
			<div>
				<p class="eyebrow">The studio</p>
				<h2>Víctor and Nina</h2>
			</div>
			<div>
				<p class="lead">
					A two-senior studio: 20 years in digital, brands like LG, Sisley and Toyota, and an
					exceptional developer who sees whole systems. We take on few projects at a time, and
					each one comes out flawless, because it carries our name.
				</p>
				<a class="link-arrow" href="/about">Meet us</a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Pricing</p>
				<h2>Clear prices, senior level</h2>
				<p>I'm not the cheapest option out there. I'm the one you won't have to pay twice.</p>
			</div>
			<div class="grid grid--3">
				<a class="card" href="/landing-pages"><h3>Landing page</h3><p class="price">from €2,900</p><p class="muted">2-3 weeks</p></a>
				<a class="card" href="/online-stores"><h3>Online store</h3><p class="price">from €7,500</p><p class="muted">4-8 weeks</p></a>
				<a class="card" href="/apps"><h3>iOS and Android app</h3><p class="price">from €3,000</p><p class="muted">from 4 weeks</p></a>
			</div>
			<p class="muted" style="margin-top:1.5rem">Maintenance from €490/month. All prices + VAT. <a href="/pricing">See all prices</a></p>
		</div>
	</section>

	<section class="section section--alt">
		<div class="container split">
			<div>
				<p class="eyebrow">Strategic audit · €450</p>
				<h2>Already have a website that doesn't sell?</h2>
			</div>
			<div>
				<p class="lead">
					I analyse your website, store or app: tech, design and conversion. You get a clear report
					with what's broken, what's unnecessary and a prioritised plan, and we go through it
					together.
				</p>
				<p>If you then hire me for the project, the €450 is fully deducted.</p>
				<div class="btn-row">
					<a class="btn btn--primary" href="/rescue">Get my audit <Arrow /></a>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container split">
			<h2>Questions</h2>
			<Faq items={faq} />
		</div>
	</section>

	<CtaBand />
</Page>

<style>
	.hero-grid {
		display: grid;
		gap: var(--s5);
		align-items: end;
	}
	@media (min-width: 900px) {
		.hero-grid {
			grid-template-columns: 1fr 380px;
			gap: var(--s6);
		}
	}
	@media (min-width: 1200px) {
		.hero-grid {
			grid-template-columns: 1fr 420px;
		}
	}
	.hero-photo .portrait {
		aspect-ratio: 4 / 5;
		max-width: 420px;
	}
	@media (max-width: 899px) {
		.hero-photo .portrait {
			max-width: 260px;
		}
	}
	.reasons {
		display: grid;
		gap: var(--s4);
	}
	.reasons div {
		border-top: 1px solid #d9d4ca;
		padding-top: var(--s3);
	}
	.reasons h3 {
		margin-bottom: 0.4rem;
	}
	.reasons p {
		margin: 0;
		max-width: 56ch;
	}
	.case-title {
		font-size: clamp(2.4rem, 1.4rem + 4vw, 4.6rem);
		max-width: 18ch;
	}
</style>
